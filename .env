# Change variables to accomodate your requirements and the latest released version of Debian 13 (also works with 12)
# Environment file version
ENV_VERSION='2026-09-13T19:27:000+02:00'
CUSTOMIZE_VERSION="3.00"
SOURCE_DIR="$HOME/git/HWHack"
RE_DIR="$HOME/git/RE"

# Additional tools selection (Anything but "Yes" with a capital Y mean do NOT install)
APT_CONFIGURE="Yes"
NIX_CONFIGURE="Always"
# Configure keyboard shortcuts
MM_BUTTONS_CONFIGURE="Yes"
# configure menu key as compose
MENU_IS_COMPOSE="Yes"

UPDATES_INSTALL="Always"
# Master "switch" for all apt installs.
APT_UTILS="Always" # Always turned on by default - None of the Debian packages will install if turned off
# Turn individual categories of apt installs on or off (Yes/No)
FORTOOLS_INSTALL="Yes"
NETTOOLS_INSTALL="Yes"
USERTOOLS_INSTALL="Yes"
SYSTOOLS_INSTALL="Yes"
PYTHON_INSTALL="Yes"
BACKPORTS_INSTALL="Yes"
# HWHacktools, Pulseview and hashcat relies on DEVTOOLS_INSTALL="Yes", Pulseview relies on BACKPORTS_INSTALL="Yes"
DEVTOOLS_INSTALL="Yes"
PULSEVIEW_INSTALL="Yes"
HASHCAT_INSTALL="Yes"
HWHACKTOOLS_INSTALL="Yes"
REVERSETOOLS_INSTALL="Yes"
DOCKER_INSTALL="Yes"

# Virtualization
VIRT_INSTALL="Yes"

# Master "switch" for all flatpak installs
FLATPAK_UTILS="Always" # Always turned on by default, none of the flatpaks will install if turned off
# Turn individual categories of flatpak installs on or off (Yes/No)
FP_USERTOOLS_INSTALL="Yes"
FP_DEVTOOLS_INSTALL="Yes"
FP_ELECTRONICSTOOLS_INSTALL="Yes"
FP_3DTOOLS_INSTALL="Yes"

# Serial port access
SERIALGROUP="dialout"
USBGROUP="plugdev"
CONFIGURE_SERIAL="Always"

# GOLANG
GO_INSTALL="Yes"
GO_URL="https://go.dev/VERSION?m=text"

# Gnome Settings
GNOME_SETTINGS="Yes"
KB_SHORTCUTS="Yes"
GNOME_DASH_TO_PANEL="Yes"
GNOME_DASH_TO_PANEL_NAME="dash-to-paneljderose9.github.com.v74.shell-extension.zip"
GNOME_DASH_TO_PANEL_URL="https://extensions.gnome.org/extension-data/dash-to-paneljderose9.github.com.v74.shell-extension.zip"
GNOME_CAFFEINE="Yes"
GNOME_CAFFEINE_NAME="caffeinepatapon.info.v60.shell-extension.zip"
GNOME_CAFFEINE_URL="https://extensions.gnome.org/extension-data/caffeinepatapon.info.v60.shell-extension.zip"

EXTENSIONS_URL="https://extensions.gnome.org/extension-data"

# Microsoft Stuff Defaulting to No for obvious "libre" reasons
MICROSOFT_APT="No"
# Microsofts repo for Debian currently do not contain much, thus workaround using Bullseye
PWSH_INSTALL="No"

# Other settings
SUDOGROUP="sudo"
DEBIAN_SUPPORTED="13"
BUILT_BY="https://www.infosecworrier.dk"